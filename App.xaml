<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Action_Wheel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Action_Wheel"
    xmlns:settings="using:Action_Wheel.Settings">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!--
                The icon font the ring draws glyphs with, shipped in Assets/Fonts rather than taken
                from the system - see Services/IconFont.cs. Declared here rather than assigned to
                Application.Resources from code: doing that in the App constructor crashed XAML
                during startup (0xc000027b inside Microsoft.UI.Xaml.dll, measured).

                The path and the family name after '#' must match the file exactly. Get either
                wrong and there is no error - the text silently falls back to the system font,
                which draws a different picture for the same code point.

                This is the "Propo" cut of the font, and it has to be. In the plain cut every icon
                keeps the monospace advance of 0.586 em while its ink runs to a full em, overflowing
                the cell through a negative right side bearing - measured, the ink's centre lands at
                0.756 of the advance instead of 0.5, which is why every icon sat right of where it
                belonged. Propo widens the advance to match the ink, so the centre is 0.500 exactly.
                The Mono cut centres too, but by shrinking every icon into the 0.586 cell.
            -->
            <FontFamily x:Key="IconFontFamily">ms-appx:///Assets/Fonts/CaskaydiaCoveNerdFontPropo-Regular.ttf#CaskaydiaCove NFP</FontFamily>

            <settings:StatusLevelConverter x:Key="StatusLevelConverter"/>
            <settings:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
            <settings:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <settings:IconPreviewConverter x:Key="IconPreviewConverter"/>

            <!--
                The one card look both windows use: a themed border around a themed fill, rounded
                corners. Centralised so every card agrees automatically instead of nine copies of the
                same four properties quietly drifting apart. Padding is deliberately not set here -
                every card in practice wants a different one, and a local Padding on the Border
                overrides this Style's Setter with no extra ceremony.
            -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <!-- A section heading inside a card: an icon from the shipped font plus bold text. -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
