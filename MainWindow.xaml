<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Action_Wheel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Action_Wheel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Action Wheel">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Everything below binds to MainViewModel, set as RootScroller's DataContext in the
         code-behind. Window is not a FrameworkElement in WinUI 3 and has no DataContext of its
         own, so the binding root has to be the content element. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,140,0"
                        VerticalAlignment="Center">
                <Image Source="/icon.ico" Width="16" Height="16"/>
                <TextBlock Text="Action Wheel" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="RootScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,24,32,28">
            <StackPanel HorizontalAlignment="Center" Spacing="18" MaxWidth="600">

                <!-- Brand header: icon badge beside title/tagline, instead of three stacked
                     centred lines - reads as an app, not a readme. -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="/icon.ico" Width="72" Height="72"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Action Wheel" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Global Radial Menu Launcher" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding VersionText, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Status first: the whole app is one global hook away from doing nothing at
                     all, so that has to be seen before anything else, not after a long scroll. -->
                <StackPanel Spacing="8">
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="{Binding HookSeverity, Converter={StaticResource StatusLevelConverter}}"
                        Title="{Binding HookTitle}"
                        Message="{Binding HookMessage}"/>

                    <InfoBar
                        IsOpen="{Binding HasUpdateAvailable, Mode=OneWay}"
                        IsClosable="True"
                        Severity="Informational"
                        Title="{Binding UpdateTitle}"
                        Message="{Binding UpdateMessage}">
                        <InfoBar.ActionButton>
                            <Button Content="View release" Command="{Binding OpenUpdateCommand}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="actions.json could not be used"
                        Message="{Binding ConfigProblemMessage}"
                        Visibility="{Binding ConfigProblemVisibility}">
                        <InfoBar.ActionButton>
                            <Button
                                Content="Restore the backup"
                                Command="{Binding RestoreBackupCommand}"
                                Visibility="{Binding RestoreBackupVisibility}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar
                        IsOpen="{Binding HasActionError, Mode=OneWay}"
                        IsClosable="True"
                        Severity="Warning"
                        Title="Something did not work"
                        Message="{Binding ActionError}"/>
                </StackPanel>

                <!-- Quick actions: how to open the ring, then the two things most people come to
                     this window to do, as a clear control row rather than embedded mid-paragraph. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Use your configured "/>
                            <Run Text="mouse trigger" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <Run Text=" anywhere on your screen to open the radial menu. The default is the middle mouse button; Settings also offers right+left and left+right mouse chords."/>
                        </TextBlock>

                        <Button Content="Button Settings"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"/>

                        <ToggleSwitch
                            Header="Start with Windows"
                            OnContent="On"
                            OffContent="Off"
                            IsOn="{Binding StartWithWindows, Mode=TwoWay}"/>

                        <InfoBar
                            IsOpen="{Binding HasStartupError, Mode=OneWay}"
                            IsClosable="True"
                            Severity="Error"
                            Title="Could not change the startup setting"
                            Message="{Binding StartupError}"/>
                    </StackPanel>
                </Border>

                <!-- Features: a scannable two-column grid instead of a vertical bullet stack. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Features" Style="{StaticResource SectionHeaderTextStyle}" FontSize="16"/>

                        <Grid ColumnSpacing="20" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Grid, not a horizontal StackPanel: a StackPanel measures its
                                 children at infinite width along its own orientation axis, so
                                 TextWrapping never had anything to wrap against and the longer
                                 lines here ran straight off the card instead. A Grid's Star column
                                 constrains the text's measure width, so wrapping actually engages. -->
                            <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00C;" FontSize="14"
                                          Foreground="#FF4CAF50" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <TextBlock Grid.Column="1" Text="Works in every app and every window" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00C;" FontSize="14"
                                          Foreground="#FF4CAF50" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <TextBlock Grid.Column="1" Text="Opens exactly at the cursor" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00C;" FontSize="14"
                                          Foreground="#FF4CAF50" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <TextBlock Grid.Column="1" Text="Press Esc or click outside to dismiss" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00C;" FontSize="14"
                                          Foreground="#FF4CAF50" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <TextBlock Grid.Column="1" Text="Stays out of Alt+Tab and the taskbar" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00C;" FontSize="14"
                                          Foreground="#FF4CAF50" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <TextBlock Grid.Column="1" Text="9 configurable buttons: shortcut, app, file or URL" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00C;" FontSize="14"
                                          Foreground="#FF4CAF50" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <TextBlock Grid.Column="1" Text="Configurable trigger, including two-button chords" TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <StackPanel Spacing="10">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="Closing this window only hides it — the app keeps running in the notification area. Right-click the tray icon to bring it back, open"/>
                        <Run Text=" Settings" FontWeight="SemiBold"/>
                        <Run Text=", or quit."/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}"/>
                        <TextBlock Text="{Binding ActiveProfileText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
