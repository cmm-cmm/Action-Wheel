<Project Sdk="Microsoft.NET.Sdk">

  <!-- A throwaway console tool, not a test project - see CLAUDE.md's "No test project exists
       (deliberately)". ConfigBackup has no WinUI/Win32 dependency, so it can be exercised from a
       plain console app like this one, referenced directly by path since there is no .sln.
       Run it with: ..\..\Build.ps1 -Task VerifyConfigBackup, or plain "dotnet run" from this folder.

       Scope note: this only exercises the REJECTION paths (bad entry count, oversized entry,
       unrecognised entry name, zip-slip) - every one of those is rejected while TryImport is still
       extracting into its own temp staging directory, before it ever touches the real
       %LOCALAPPDATA%\ActionWheel files. A positive "a well-formed backup restores correctly" case,
       or a rollback-after-partial-failure case, would need TryImport to actually reach its commit
       phase - which writes to those real files (ActionConfig.ActiveConfigPath, preferences.json,
       Profiles\*.xml) with no way to redirect them, since AppDataPaths.DirectoryPath is not
       injectable. Exercising that safely on a developer's own machine, without a chance of
       clobbering their real button config, was judged not worth the risk for what this tool is -
       see ActionWheel.Core/ConfigBackup.cs's own commit-phase rollback logic and comments for that
       path's reasoning instead. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Action_Wheel.Tools.ConfigBackupCheck</RootNamespace>
    <AssemblyName>ConfigBackupCheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Its own bin/obj, outside the app's; Build.ps1's Clean task removes both by name. -->
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ActionWheel.Core\ActionWheel.Core.csproj" />
  </ItemGroup>

</Project>
