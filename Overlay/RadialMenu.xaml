<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Action_Wheel.Overlay.RadialMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Action_Wheel.Overlay"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Make root transparent so wallpaper shows through -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            
            <!--
                Style cho buttons bên ngoài.

                Các button này BẮT BUỘC phải dùng ControlTemplate riêng thay vì dựa vào template
                mặc định của WinUI: ở template mặc định, Background/Foreground đặt trên Button chỉ
                có tác dụng ở trạng thái nghỉ ban đầu - VisualState "PointerOver" ghi đè trực tiếp
                lên ContentPresenter bằng theme brush, còn state "Normal" KHÔNG có setter nào để
                khôi phục, nên màu hover bị kẹt vĩnh viễn sau lần rê chuột đầu tiên.
                (Xem "lightweight styling" trong tài liệu XAML styles của Microsoft.)

                Template này dùng TemplateBinding cho màu và CỐ Ý không khai báo màu trong bất kỳ
                VisualState nào - màu của từng nút đến từ actions.json nên phải do code đặt vào
                Background/Foreground của Button. Setter màu trong VisualState sẽ ghi đè lên giá trị
                đó. Hover/pressed được RadialMenu.ApplyPointerStates xử lý trong code-behind; ở đây
                chỉ còn hiệu ứng phóng to.
            -->
            <Style x:Key="RadialButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <!-- Defaults only. Button size is a user setting, so RadialMenu.ApplySizes writes
                     Width/Height/CornerRadius onto each Button as local values and the template
                     below reads them back through TemplateBinding rather than hard-coding 44/22. -->
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <!-- RenderTransformOrigin, not CenterX/CenterY: the origin is a
                                     fraction of the element, so it stays the middle whatever
                                     diameter the user picks. Absolute centres would need
                                     rewriting on every size change. -->
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <!-- Rỗng và nằm DƯỚI Bd: RadialMenu.ApplyShadow gắn sprite visual
                                     đổ bóng vào đây, nên bóng được vẽ phía sau nút. -->
                                <Border x:Name="ShadowHost"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}"/>

                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter x:Name="ContentHost"
                                                      Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="HoverScale.ScaleX" Value="1"/>
                                                <Setter Target="HoverScale.ScaleY" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverScale.ScaleX" Value="1.12"/>
                                                <Setter Target="HoverScale.ScaleY" Value="1.12"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverScale.ScaleX" Value="0.94"/>
                                                <Setter Target="HoverScale.ScaleY" Value="0.94"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Style cho center button. Cùng lý do phải dùng template riêng như trên. -->
            <Style x:Key="CenterButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Border x:Name="ShadowHost"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}"/>

                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter x:Name="ContentHost"
                                                      Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="HoverScale.ScaleX" Value="1"/>
                                                <Setter Target="HoverScale.ScaleY" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverScale.ScaleX" Value="1.12"/>
                                                <Setter Target="HoverScale.ScaleY" Value="1.12"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverScale.ScaleX" Value="0.94"/>
                                                <Setter Target="HoverScale.ScaleY" Value="0.94"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- Optimized window size for full radial menu without clipping -->
        <!-- No RenderTransform here. RingOpenAnimation attaches a CompositeTransform with a
             centred origin: the old ScaleTransform had no origin, so scaling 0.85 -> 1 pivoted on
             the top-left corner and slid the ring 30 DIP away from the cursor on the way in. -->
        <Grid x:Name="MenuContainer" Width="400" Height="400" Background="Transparent">
            
            <Canvas x:Name="ButtonsCanvas" Width="400" Height="400" Background="Transparent">
                <!-- 8 buttons positioned in a circle, updated at runtime -->
                <!-- Top (0°) -->
                <Button x:Name="Btn1" Canvas.Left="172" Canvas.Top="24" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 1" Click="ActionButton_Click" Tag="1" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF0C5;" FontSize="14"/>
                </Button>
                
                <!-- Top-Right (45°) -->
                <Button x:Name="Btn2" Canvas.Left="250" Canvas.Top="56" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 2" Click="ActionButton_Click" Tag="2" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF0EA;" FontSize="14"/>
                </Button>
                
                <!-- Right (90°) -->
                <Button x:Name="Btn3" Canvas.Left="290" Canvas.Top="236" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 3" Click="ActionButton_Click" Tag="3" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF0C4;" FontSize="14"/>
                </Button>
                
                <!-- Bottom-Right (135°) -->
                <Button x:Name="Btn4" Canvas.Left="250" Canvas.Top="398" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 4" Click="ActionButton_Click" Tag="4" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF030;" FontSize="14"/>
                </Button>
                
                <!-- Bottom (180°) -->
                <Button x:Name="Btn5" Canvas.Left="172" Canvas.Top="430" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 5" Click="ActionButton_Click" Tag="5" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF013;" FontSize="14"/>
                </Button>
                
                <!-- Bottom-Left (225°) -->
                <Button x:Name="Btn6" Canvas.Left="94" Canvas.Top="398" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 6" Click="ActionButton_Click" Tag="6" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF009;" FontSize="14"/>
                </Button>
                
                <!-- Left (270°) -->
                <Button x:Name="Btn7" Canvas.Left="62" Canvas.Top="236" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 7" Click="ActionButton_Click" Tag="7" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF114;" FontSize="14"/>
                </Button>
                
                <!-- Top-Left (315°) -->
                <Button x:Name="Btn8" Canvas.Left="94" Canvas.Top="56" Style="{StaticResource RadialButtonStyle}" ToolTipService.ToolTip="Action 8" Click="ActionButton_Click" Tag="8" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF023;" FontSize="14"/>
                </Button>
                
                <!-- Center Button - Màu Đỏ -->
                <Button x:Name="CenterBtn" Canvas.Left="174" Canvas.Top="174" Style="{StaticResource CenterButtonStyle}" Click="ActionButton_Click" Tag="0" Opacity="0">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF00D;" FontSize="14"/>
                </Button>
            </Canvas>
        </Grid>
    </Grid>
</Window>
